# Banco Postgres local (container criado conforme o README).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"

# Segredo de assinatura das sessões. Obrigatório — o servidor não sobe sem ele.
# Gere o seu com:
#   mise x -- python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Porta do backend Go. O servidor Vite (5173) faz proxy de /api para cá.
PORT="8080"

# Endereço de entrada do usuário em desenvolvimento: o servidor Vite.
BASE_URL="http://localhost:5173"

# Conta de administrador criada no primeiro boot. No primeiro login o app
# obriga a definir uma senha definitiva.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"

# Carrega os dados de demonstração quando o banco está vazio.
SEED_DEMO="1"

# Verificação anti-bot no login (Cloudflare Turnstile). Desligada por padrão:
# sem as duas chaves, o login não apresenta desafio. Para experimentar
# localmente, descomente as chaves de teste do Cloudflare, que sempre aprovam.
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
